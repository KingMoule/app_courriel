# Copier ce fichier en .env (ignoré par git) et remplir les valeurs.
ANTHROPIC_API_KEY=sk-ant-...
# Sujet ntfy secret : une longue chaîne au hasard, la même que dans l'app ntfy du iPhone.
NTFY_TOPIC=
# Outlook (perso_ancien, travail) : « ID d'application (client) » de l'inscription dans Entra. Pas un secret, mais propre à toi.
MS_CLIENT_ID=
